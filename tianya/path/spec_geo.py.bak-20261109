def node(name, sec, secTitle, page, desc, pre):
    return dict(name=name, sec=sec, secTitle=secTitle, page=page, desc=desc,
                criteria=['能复述本节核心概念与数据', '能看懂案例图表的判读过程', '能独立做对基础题',
                          '能独立做对应用题', '能独立做对综合题并讲清判读依据'],
                diag=None, pre=pre, next=[])

